# Copy to .env, or run `python make_env.py` to fill in random secrets. Never commit .env.

# JWT signing key, at least 32 random characters
JWT_SECRET=
# Demo password for admin/ops/viewer @bankmuscat.demo (demo use only)
CASHCAST_DEMO_PASSWORD=demo123

MYSQL_DATABASE=cashcast
MYSQL_USER=cashcast
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Used when the API runs outside Docker. 3307 is the port docker-compose publishes for its MySQL;
# use 3306 if you run your own MySQL server. (docker-compose sets its own host/port for the API container.)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# Extra browser origins that may call the API directly (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
